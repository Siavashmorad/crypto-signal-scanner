# Deployment secrets only. Never commit real values.
SIGNAL_SCANNER_USERNAME=Siavashmorad
SIGNAL_SCANNER_PASSWORD_HASH=generated_pbkdf2_sha256_hash

# signal_only | paper | live_with_approval
# Default is signal_only. Live never runs without explicit user approve on each action.
EXECUTION_MODE=signal_only

# Required only for EXECUTION_MODE=live_with_approval
# Create keys on Tabdeal with TRADE permission. Never put these in the APK.
TABDEAL_API_KEY=
TABDEAL_API_SECRET=

# AI provider secrets stay on the private backend. Never put them in the APK.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
